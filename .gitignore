# Unity generated / rebuildable folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never ignore Library/PackageCache meta if needed — but full Library/ is safe to ignore, Unity rebuilds it.

# Autogenerated VS/Rider/MD/VSCode solution and project files
.vs/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files that shouldn't be ignored are NOT listed here on purpose (Assets/**/*.meta must stay tracked)

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Crashlytics generated file
crashlytics-build.properties

# Editor uses these to import/export packages
*.unitypackage
!*.unitypackage.meta

# OS / editor cruft
.DS_Store
Thumbs.db

# Claude Code local-only settings (machine-specific permission rules, not shared project config)
.claude/settings.local.json

# Accidental nested Unity project copies found at repo root (2026-09-25) —
# each is a full duplicate project (own Assets/Library/Logs/etc.), not meant
# to be tracked.
/My project/
/My project (1)/

# PROTOFACTOR Ultimate Animation Collection (paid Asset Store pack, 239 MB):
# only the 14 clips the R&D combat uses are versioned (guard, punches,
# block, stunned, blows taken — RnDCombatAnimationTools). The rest is
# imported from the Asset Store account when needed.
/Assets/PROTOFACTOR/**
!/Assets/PROTOFACTOR/**/
!/Assets/PROTOFACTOR/UltimateAnimationCollection.meta
!/Assets/PROTOFACTOR/UltimateAnimationCollection/Animations.meta
!/Assets/PROTOFACTOR/UltimateAnimationCollection/Animations/Combat Bare Fists Animset.meta
!/Assets/PROTOFACTOR/UltimateAnimationCollection/Animations/Combat Bare Fists Animset/FBX Motions.meta
!/Assets/PROTOFACTOR/UltimateAnimationCollection/Animations/Combat Bare Fists Animset/FBX Motions/Humanoid@IdleCombat.fbx*
!/Assets/PROTOFACTOR/UltimateAnimationCollection/Animations/Combat Bare Fists Animset/FBX Motions/Humanoid@Jab1.fbx*
!/Assets/PROTOFACTOR/UltimateAnimationCollection/Animations/Combat Bare Fists Animset/FBX Motions/Humanoid@RightHand1.fbx*
!/Assets/PROTOFACTOR/UltimateAnimationCollection/Animations/Combat Bare Fists Animset/FBX Motions/Humanoid@Stunned.fbx*
!/Assets/PROTOFACTOR/UltimateAnimationCollection/Animations/Combat Bare Fists Animset/FBX Motions/Humanoid@IdleBlockHigh.fbx*
!/Assets/PROTOFACTOR/UltimateAnimationCollection/Animations/Combat Bare Fists Animset/FBX Motions/Humanoid@BlockedHigh.fbx*
!/Assets/PROTOFACTOR/UltimateAnimationCollection/Animations/Combat Bare Fists Animset/FBX Motions/Humanoid@GetHit*LightCombat.fbx*
!/Assets/PROTOFACTOR/UltimateAnimationCollection/Animations/Combat Bare Fists Animset/FBX Motions/Humanoid@GetHit*HeavyCombat.fbx*
