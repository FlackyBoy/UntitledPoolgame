# Unity generated / rebuildable folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never ignore Library/PackageCache meta if needed — but full Library/ is safe to ignore, Unity rebuilds it.

# Autogenerated VS/Rider/MD/VSCode solution and project files
.vs/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files that shouldn't be ignored are NOT listed here on purpose (Assets/**/*.meta must stay tracked)

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Crashlytics generated file
crashlytics-build.properties

# Editor uses these to import/export packages
*.unitypackage
!*.unitypackage.meta

# OS / editor cruft
.DS_Store
Thumbs.db

# Claude Code local-only settings (machine-specific permission rules, not shared project config)
.claude/settings.local.json
